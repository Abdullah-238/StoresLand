<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.StoresForSell.StoreForSellPage.pgStoreForSellPage"
             Title="{Binding Store.Name}"
             xmlns:str="clr-namespace:StoresPlace_Front.Strings"
             x:Name="StoreForSell"
             Padding="24"
             xmlns:Store="clr-namespace:StoresPlace_Front.StoresForSell.StoreForSellPage"
             Shell.TabBarIsVisible="False"
             IsBusy="{Binding IsBusy}"
             Loaded="StorePage_Loaded"
             NavigatedTo="StorePage_NavigatedTo"
             >

    <ContentPage.BindingContext>
        <Store:StoreForSellViewModel/>
    </ContentPage.BindingContext>


    <Border StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" VerticalOptions="StartAndExpand">

        <VerticalStackLayout  BackgroundColor="Transparent" Padding="12" Spacing="8">

            <VerticalStackLayout  BindingContext="{Binding Store}"  Spacing="8">

                <Border StrokeShape="RoundRectangle 8" Stroke="Transparent">
                    <Grid RowDefinitions="*,*,*"   ColumnDefinitions="*,*"  RowSpacing="8"   ColumnSpacing="12" >

                        <HorizontalStackLayout Grid.Row="0"  Spacing="8" >




                            <Frame    CornerRadius="4"  BackgroundColor="Transparent" BorderColor="Transparent" HeightRequest="48" WidthRequest="48" >
                                <Image  Source="{Binding Photo}" Aspect="AspectFill"  x:Name="imgCustomerImage"  HeightRequest="48" WidthRequest="48"/>
                            </Frame>

                            <VerticalStackLayout VerticalOptions="Center">
                                <Label FontAttributes="Bold" HorizontalTextAlignment="Start" Text="{Binding Name}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" MaxLines="1"/>
                                <HorizontalStackLayout Spacing="4">
                                    <Image HeightRequest="18" WidthRequest="18" Source="location"/>
                                    <Label VerticalTextAlignment="Center" FontSize="Micro" Text="{Binding Address}"  MaxLines="1"  HorizontalTextAlignment="Start"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="4"  Grid.Row="0"  Grid.Column="2"  HorizontalOptions="End" VerticalOptions="Start">
                            <Image Source="star"/>
                            <Label  FontSize="Micro" Text="{Binding Rating}" MaxLines="1" VerticalTextAlignment="Center"/>
                            <!--<Label  FontSize="Micro"  HorizontalOptions="Start" VerticalTextAlignment="Center">
    <Label.FormattedText>
        <FormattedString>
            <Span Text="("/>
            <Span Text="{Binding NumberOfRates}"/>
            <Span Text=")"/>
        </FormattedString>
    </Label.FormattedText>
</Label>-->
                        </HorizontalStackLayout>

                    </Grid>
                </Border>



                <Label TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" FontSize="Caption"  Text="{x:Static str:AppStrings.Website}" MaxLines="1" />

                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" HorizontalOptions="StartAndExpand" >
                    <Label  Padding="12,4,12,4" Background="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource PrimaryBrush}}" TextColor="White"
                         FontSize="Caption"                             
                            Text="{Binding Website ,TargetNullValue={x:Static str:AppStrings.No_Website}}" 
                         LineBreakMode="TailTruncation" MaxLines="2"  TextTransform="Lowercase" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                                  Command="{Binding Path=BindingContext.OpenUrl, Source={x:Reference StoreForSell}}"
                                                  CommandParameter="{Binding Website}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

            </VerticalStackLayout>


            <Button Text="{Binding IsSaved}"
              Command="{Binding Path=BindingContext.AddToSavedStores, Source={x:Reference StoreForSell}}"
              CommandParameter="{Binding Store.StoreID}"/>

          

            <!--<Button 
Command="{Binding Path=BindingContext.CancelOrder, Source={x:Reference OrderPage}}" 
CommandParameter="{Binding OrderNumber}" 
 Grid.ColumnSpan="4" Grid.Row="4" Grid.Column="0" Text="{x:Static str:AppStrings.Cancel}" BackgroundColor="#FFDAD6" TextColor="Red"  />-->


        </VerticalStackLayout>
    </Border>

</ContentPage>