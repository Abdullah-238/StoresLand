<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.Main.Controls.ctvTypeContainer" 
             x:Name="This"
             >

    <Border Stroke="Transparent" >

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4"  />
        </Border.StrokeShape>

        <VerticalStackLayout   Spacing="12"  Padding="40" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}">

            <!--<Frame BackgroundColor="{StaticResource Primary50}" HeightRequest="40" WidthRequest="40" BorderColor="Transparent" CornerRadius="6">
            </Frame>-->

            <!--<Image x:Name="IconImage"  Source="{Binding Icon, FallbackValue='home'}" Margin="24,24,24,0"/>-->


            <Label FontAttributes="Bold" Text="{Binding CardTitle, FallbackValue='Online Store'}" HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </Border>

</ContentView>
