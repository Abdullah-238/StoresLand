<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.Settings.MyStores.pgMyStores"
               Title="{x:Static str:AppStrings.My_Stores}"
              xmlns:str="clr-namespace:StoresPlace_Front.Strings"
              x:Name="PersonStore"
              Shell.TabBarIsVisible="False"
              xmlns:Control="clr-namespace:StoresPlace_Front.Global.GlobalControl"
              xmlns:Store="clr-namespace:StoresPlace_Front.Settings.SettingsViewModel"
              Appearing="PersonStore_Appearing"
             >



    <ContentPage.BindingContext>
        <Store:clsMyStoreViewModel></Store:clsMyStoreViewModel>
    </ContentPage.BindingContext>


    <RefreshView  x:Name="refresh"  Refreshing="RefreshView_Refreshing">
        <ScrollView>

            <StackLayout Padding="24">
                <CollectionView ItemsSource="{Binding MyStores}" EmptyView="{x:Static str:AppStrings.No_Stores}">

                    <CollectionView.ItemsLayout >
                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" >
                                <Grid RowDefinitions="*,*,*"   ColumnDefinitions="*,*"  RowSpacing="8"   ColumnSpacing="12" BackgroundColor="Transparent" Padding="12">

                                    <Border Grid.Column="2"  BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"   
                                            HorizontalOptions="End" Padding="10,2,10,2"  StrokeShape="RoundRectangle 100" Stroke="Transparent" >
                                        <Label Text="{Binding StoreStatus}" TextColor="{StaticResource White}"  MaxLines="1"  FontSize="Caption"/>
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="1"  Spacing="8" >


                                        <Frame   CornerRadius="4"  BackgroundColor="Transparent" BorderColor="Transparent" HeightRequest="48" WidthRequest="48" >
                                            <Image HeightRequest="48" WidthRequest="48"  Aspect="AspectFill"  Source="{Binding Photo}"/>
                                        </Frame>



                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" MaxLines="1"/>
                                            <HorizontalStackLayout Spacing="4">
                                                <Image HeightRequest="18" WidthRequest="18" Source="location"/>
                                                <Label Text="{Binding Address}"  MaxLines="1" VerticalTextAlignment="Center" FontSize="Micro"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="4"  Grid.Row="1"  Grid.Column="2"  HorizontalOptions="End" VerticalOptions="Center">
                                        <Image Source="star"/>
                                        <Label  FontSize="Micro" Text="{Binding Rating}" MaxLines="1" VerticalTextAlignment="Center"/>
                                        <!--<Label  FontSize="Caption"  HorizontalOptions="Start">
    <Label.FormattedText>
        <FormattedString>
            <Span Text="("/>
            <Span Text="{Binding NumberOfRates}"/>
            <Span Text=")"/>
        </FormattedString>
    </Label.FormattedText>
</Label>-->
                                    </HorizontalStackLayout>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Path=BindingContext.MoveToStoreCommand, Source={x:Reference PersonStore}}"
                                            CommandParameter="{Binding StoreID}"></TapGestureRecognizer>
                                    </Grid.GestureRecognizers>
                                    
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" TranslationY="-100"  />


            </StackLayout>
            
            
        </ScrollView>
    </RefreshView>
</ContentPage>