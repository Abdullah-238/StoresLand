<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.pgSettings"
             xmlns:controls="clr-namespace:StoresPlace_Front.AppSettings.Control"
             xmlns:app="clr-namespace:Microsoft.Maui.ApplicationModel;assembly=Microsoft.Maui.Essentials"
             x:Name="Settings"
             Shell.NavBarIsVisible="True"
             xmlns:str="clr-namespace:StoresPlace_Front.Strings"
             xmlns:Control="clr-namespace:StoresPlace_Front.Global.GlobalControl"
             
             Appearing="Settings_Appearing"
             >



    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,24" Spacing="12" >


            <HorizontalStackLayout HorizontalOptions="Start" IsVisible="False">
                <Label VerticalTextAlignment="Center" Text="{x:Static str:AppStrings.Welcome_to_ }" FontSize="Large" FontAttributes="Bold"/>
                <Image  HorizontalOptions="Center" Source="appicon.svg" HeightRequest="84" WidthRequest="84"/>
            </HorizontalStackLayout>


            <controls:ctvSettings Icon="account" CardTitle="{x:Static str:AppStrings.Profile }">
                <controls:ctvSettings.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </controls:ctvSettings.GestureRecognizers>
            </controls:ctvSettings>

            <controls:ctvSettings Icon="store" CardTitle="{x:Static str:AppStrings.My_Stores }">
                <controls:ctvSettings.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                </controls:ctvSettings.GestureRecognizers>
            </controls:ctvSettings>
            
            
            <controls:ctvSettings Icon="add_new_store" CardTitle="{x:Static str:AppStrings.Add_New_Store }">
                <controls:ctvSettings.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                </controls:ctvSettings.GestureRecognizers>
            </controls:ctvSettings>

            <controls:ctvSettings Icon="save_store" CardTitle="{x:Static str:AppStrings.Saved_stores }" >
                <controls:ctvSettings.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_6"/>
                </controls:ctvSettings.GestureRecognizers>
            </controls:ctvSettings>

            <controls:ctvSettings Icon="settings" CardTitle="{x:Static str:AppStrings.Settings }">
                <controls:ctvSettings.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_4"/>
                </controls:ctvSettings.GestureRecognizers>
            </controls:ctvSettings>


            <Button ImageSource="sign_out" x:Name="btnSignIn" Style="{StaticResource ThirdButton}" Text="{x:Static str:AppStrings.Sign_Out }" Clicked="Button_Clicked"/>

            <Control:ctvActiveIndector x:Name="ctvActiveIndector1"  IsRunning="False" TranslationY="-50" />


            <Label HorizontalOptions="Center" FontSize="Caption">
                <Label.FormattedText >
                    <FormattedString>
                        <Span Text="{x:Static str:AppStrings.Version}"></Span>
                        <Span Text="  "></Span>
                        <Span Text="{x:Static app:AppInfo.VersionString}"></Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label Text="{x:Static str:AppStrings.This_is_a_trial_version}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" FontSize="Micro"/>




        </VerticalStackLayout>

    </ScrollView>
</ContentPage>

