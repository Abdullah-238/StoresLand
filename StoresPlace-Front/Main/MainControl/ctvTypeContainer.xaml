<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.Main.Controls.ctvTypeContainer" 
             x:Name="This"
             >

    <Border   Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"  >

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4"   />
        </Border.StrokeShape>

        <HorizontalStackLayout  Margin="0" Spacing="12" BackgroundColor="Transparent" >


            <BoxView Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" WidthRequest="6" VerticalOptions="FillAndExpand" />

            <!--<Image x:Name="IconImage"  Source="{Binding Icon, FallbackValue='store'}" HeightRequest="48" WidthRequest="48" VerticalOptions="Start"  HorizontalOptions="Start"/>-->


            <Label Padding="24,48,24,48" FontAttributes="Bold" Text="{Binding CardTitle, FallbackValue='Online Store'}" HorizontalTextAlignment="Start" 
                   VerticalTextAlignment="Start" VerticalOptions="Center" HorizontalOptions="Center"/>

        </HorizontalStackLayout>
    </Border>

</ContentView>
