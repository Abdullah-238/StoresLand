<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.Login.pgResetPassword"
             xmlns:str="clr-namespace:StoresPlace_Front.Strings"
             xmlns:Control="clr-namespace:StoresPlace_Front.Global.GlobalControl"
             Title="{x:Static str:AppStrings.Reset_Password }">
    
    <VerticalStackLayout Padding="24" VerticalOptions="Center" Spacing="24">
        <Label 
            Text="{x:Static str:AppStrings.Please_enter_the_email_you_would_like_to_send_to_reset_your_password} " />

        <Entry x:Name="enEmail" Placeholder="{x:Static str:AppStrings.Email}"/>



        <Button  x:Name="btnSend" Text="{x:Static str:AppStrings.Send }" Clicked="Button_Clicked"/>

        <Control:ctvActiveIndector x:Name="ctvActiveIndector1"  IsRunning="False" />

    </VerticalStackLayout>
</ContentPage>